# ---------- Public site ----------
# Canonical site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Verified contact details — leave blank until confirmed by Fidelity.
# Components that need them stay hidden while they are empty.
NEXT_PUBLIC_CONTACT_PHONE=          # e.g. +251 9xx xxx xxx
NEXT_PUBLIC_CONTACT_WHATSAPP=       # digits only, international format, e.g. 2519xxxxxxxx
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=         # street / building — city is already "Wolaita Sodo, Ethiopia"
NEXT_PUBLIC_BUSINESS_HOURS=         # e.g. Mon–Sat, 8:30–17:30
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# Privacy-friendly analytics (optional). Example: Plausible domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- Lead management (server only) ----------
# Password for /admin. Use a long random value.
ADMIN_PASSWORD=
# Secret used to sign admin session cookies (32+ random characters).
ADMIN_SESSION_SECRET=
# Where inquiries and uploads are stored (must be a persistent disk in production).
DATA_DIR=./data
